# =============================================================================
# PART 1/2 — the ComfyUI runtime ("config UI") image: base + torch + ComfyUI +
# custom nodes + workflows + SSH.  No model weights here.
#
# Model weight layers are built separately (Dockerfile.models) and merged at the
# registry by ops/compose-image.py, because a single GitHub runner has only
# ~43 GB free and the finished images are 86 GB (H3) and 49 GB (Qwen).
#
# SageAttention is deliberately NOT built: dense attention uses ComfyUI core's
# "comfy kitchen attention" (ModelAttentionBackend in the Seed Hunter workflow).
# =============================================================================
FROM nvidia/cuda:13.0.1-cudnn-runtime-ubuntu24.04

ARG DEBIAN_FRONTEND=noninteractive
ARG TORCH_INDEX=cu130
# 1 = download the weights into this image (PPIO/Novita prewarm this tag).
# 0 = code-only (SimplePod: its hosts loop forever on our ~20 GB layers).
# Both tags ship fetch-models-boot.sh, which is a no-op when the weights are
# already present -- so the image decides for itself at boot.
ARG BAKED_MODELS=0
ARG COMFYUI_REF=8d534945
ARG SSH_AUTHORIZED_KEY=""
ARG FFMPEG_URL="https://github.com/BtbN/FFmpeg-Builds/releases/download/latest/ffmpeg-master-latest-linux64-gpl.tar.xz"

ENV PYTHONUNBUFFERED=1 \
    COMFYUI_PATH=/opt/ComfyUI \
    VIRTUAL_ENV=/opt/comfyui-venv \
    PATH=/opt/ffmpeg/bin:/opt/comfyui-venv/bin:/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    OPENBLAS_NUM_THREADS=1 \
    OMP_NUM_THREADS=4

# A C/C++ toolchain is REQUIRED at runtime, not just at build time: Triton compiles a
# small helper module (its CudaUtils shim) on first use, and torch's _native ops pick
# Triton impls on a 4090. Without `cc` this dies with
#   RuntimeError: Failed to find C compiler. Please specify via CC ...
# which takes down the whole MiniMax-H3 text-encode path
# (MiniMaxH3ReferenceToVideo -> clip.encode -> llama.precompute_freqs_cis ->
#  torch._native.bmm_outer_product -> triton). python3-dev supplies the Python.h
# headers that shim needs to include.
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-venv python3-pip python3-dev \
        gcc g++ \
        git wget curl xz-utils ca-certificates \
        openssh-server tini procps \
        libgl1 libglib2.0-0 libsm6 libxext6 libxrender1 libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd /root/.ssh \
    && chmod 700 /root/.ssh \
    && test -x /usr/sbin/sshd \
    && cc --version >/dev/null

# Static ffmpeg (NVENC-capable, uses the host's libnvidia-encode) instead of the
# apt package + its ~500 MB of dependency chain.
RUN mkdir -p /opt/ffmpeg/bin && cd /tmp \
    && wget -q -O ff.tar.xz "$FFMPEG_URL" \
    && tar -xJf ff.tar.xz \
    && FFDIR=$(find /tmp -maxdepth 1 -type d -name 'ffmpeg-*-linux64-gpl' | head -1) \
    && cp -a "$FFDIR"/bin/ffmpeg "$FFDIR"/bin/ffprobe /opt/ffmpeg/bin/ \
    && ln -sf /opt/ffmpeg/bin/ffmpeg /usr/local/bin/ffmpeg \
    && ln -sf /opt/ffmpeg/bin/ffprobe /usr/local/bin/ffprobe \
    && rm -rf /tmp/ff* \
    && ffmpeg -hide_banner -version | head -1

RUN python3 -m venv /opt/comfyui-venv \
    && /opt/comfyui-venv/bin/pip install -U --no-cache-dir pip wheel setuptools \
    && /opt/comfyui-venv/bin/pip install --no-cache-dir \
        torch torchvision torchaudio --index-url "https://download.pytorch.org/whl/${TORCH_INDEX}" \
    && /opt/comfyui-venv/bin/python -c "import torch;print('torch',torch.__version__,'cuda',torch.version.cuda)"

RUN git clone https://github.com/comfyanonymous/ComfyUI.git /opt/ComfyUI \
    && cd /opt/ComfyUI \
    && git checkout "${COMFYUI_REF}" \
    && /opt/comfyui-venv/bin/pip install --no-cache-dir -r requirements.txt \
    && /opt/comfyui-venv/bin/python -c "import comfy_kitchen; print('comfy-kitchen ok')" \
    && rm -rf /opt/ComfyUI/.git

COPY build/nodes.sh /opt/nodes.sh
# our own pack (handoff/SEEDVR2_BULK_HANDOFF.md §4): multi-file video upload
# button + one-click "download all as ZIP". Cloned packs land in the same dir.
COPY build/bulk_io/ /opt/ComfyUI/custom_nodes/bulk_io/
RUN bash /opt/nodes.sh \
    && cd /opt/ComfyUI \
    && for req in custom_nodes/*/requirements.txt; do \
         [ -f "$req" ] && /opt/comfyui-venv/bin/pip install --no-cache-dir -r "$req" || true; \
       done \
    && /opt/comfyui-venv/bin/pip install --no-cache-dir \
         piexif rotary-embedding-torch numexpr imageio-ffmpeg pykalman \
         spandrel spandrel_extra_arches pandas segment-anything webcolors \
         sqlalchemy opencv-python-headless scikit-image \
    && rm -rf /root/.cache/pip /opt/ComfyUI/models/*/.git 2>/dev/null || true

COPY workflows/ /opt/ComfyUI/user/default/workflows/
COPY build/start.sh /opt/start.sh
COPY build/sshsetup.sh /opt/sshsetup.sh
COPY build/verify-env.sh /opt/verify-env.sh
COPY build/patch-frontend.sh /opt/patch-frontend.sh
COPY build/patch-cache.sh /opt/patch-cache.sh
COPY build/normalize-models.sh /opt/normalize-models.sh
COPY build/patch-seedvr2.sh /opt/patch-seedvr2.sh
COPY build/patch-timing.sh /opt/patch-timing.sh
# Rebuilds weights that the models image ships as .partNNN chunks. Lazy: only
# the directories start.sh names are touched, so a platform that never loads a
# chunked model never pays for the stitch.
# Boot-time weight provisioning. The image answers one question: are the weights already
# on disk? Present -> nothing to do (the :models tag, which PPIO and Novita prewarm).
# Absent -> fetch them from Hugging Face (the code-only tag SimplePod must use, because
# its hosts cannot unpack our ~20 GB weight layers).
COPY build/models-source.sh /opt/models-source.sh
COPY build/fetch-models-boot.sh /opt/fetch-models-boot.sh
# The Hugging Face fetcher. Used at BUILD time when BAKED_MODELS=1, and at RUNTIME by
# fetch-models-boot.sh when the image was built without weights.
COPY build/models-part.sh /opt/models-part.sh

# Bake the weights only for the tag PPIO and Novita prewarm. Split out of the code layers
# on purpose: this is one RUN that either produces a big layer (BAKED_MODELS=1) or is
# skipped entirely, so a code-only build never carries it.
RUN --mount=type=secret,id=hf_token,required=false \
    if [ "${BAKED_MODELS}" = "1" ]; then \
        export HF_TOKEN="${HF_TOKEN:-$(cat /run/secrets/hf_token 2>/dev/null || true)}"; \
        for p in h3-fl2va h3-singularity h3enc h3vae-kijai h3vae-audio h3loras h3extra seedvr2; do \
            echo "=== baking $p ==="; \
            PART="$p" bash /opt/models-part.sh || exit 1; \
        done; \
        du -sh /opt/ComfyUI/models 2>/dev/null; \
    else \
        echo "BAKED_MODELS=0: code-only image, weights come from Hugging Face at boot"; \
    fi

RUN bash /opt/patch-frontend.sh \
    && bash /opt/patch-cache.sh \
    && bash /opt/patch-seedvr2.sh \
    && bash /opt/patch-timing.sh \
    && chmod +x /opt/start.sh /opt/sshsetup.sh /opt/verify-env.sh /opt/patch-frontend.sh /opt/patch-cache.sh /opt/normalize-models.sh /opt/patch-seedvr2.sh /opt/patch-timing.sh \
    /opt/models-source.sh /opt/fetch-models-boot.sh /opt/models-part.sh \
    && SSH_AUTHORIZED_KEY="${SSH_AUTHORIZED_KEY}" bash /opt/sshsetup.sh \
    && bash /opt/verify-env.sh

EXPOSE 22 8188
WORKDIR /opt/ComfyUI
ENTRYPOINT ["/usr/bin/tini","--"]
CMD ["/opt/start.sh"]
