# =============================================================================
# PART 1/2 — the ComfyUI runtime ("config UI") image: base + torch + ComfyUI +
# custom nodes + workflows + SSH.  No model weights here.
#
# Model weight layers are built separately (Dockerfile.models) and merged at the
# registry by ops/compose-image.py, because a single GitHub runner has only
# ~43 GB free and the finished images are 86 GB (H3) and 49 GB (Qwen).
#
# SageAttention is deliberately NOT built: dense attention uses ComfyUI core's
# "comfy kitchen attention" (ModelAttentionBackend in the Seed Hunter workflow).
# =============================================================================
FROM nvidia/cuda:13.0.1-cudnn-runtime-ubuntu24.04

ARG DEBIAN_FRONTEND=noninteractive
ARG TORCH_INDEX=cu130
ARG COMFYUI_REF=8d534945
ARG SSH_AUTHORIZED_KEY=""
ARG FFMPEG_URL="https://github.com/BtbN/FFmpeg-Builds/releases/download/latest/ffmpeg-master-latest-linux64-gpl.tar.xz"

ENV PYTHONUNBUFFERED=1 \
    COMFYUI_PATH=/opt/ComfyUI \
    VIRTUAL_ENV=/opt/comfyui-venv \
    PATH=/opt/ffmpeg/bin:/opt/comfyui-venv/bin:/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    OPENBLAS_NUM_THREADS=1 \
    OMP_NUM_THREADS=4

# No compiler / python3-dev / git-lfs: nothing is built from source any more
# (SageAttention is gone), and every dependency ships manylinux wheels.
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-venv python3-pip \
        git wget curl xz-utils ca-certificates \
        openssh-server tini procps \
        libgl1 libglib2.0-0 libsm6 libxext6 libxrender1 libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd /root/.ssh \
    && chmod 700 /root/.ssh \
    && test -x /usr/sbin/sshd

# Static ffmpeg (NVENC-capable, uses the host's libnvidia-encode) instead of the
# apt package + its ~500 MB of dependency chain.
RUN mkdir -p /opt/ffmpeg/bin && cd /tmp \
    && wget -q -O ff.tar.xz "$FFMPEG_URL" \
    && tar -xJf ff.tar.xz \
    && FFDIR=$(find /tmp -maxdepth 1 -type d -name 'ffmpeg-*-linux64-gpl' | head -1) \
    && cp -a "$FFDIR"/bin/ffmpeg "$FFDIR"/bin/ffprobe /opt/ffmpeg/bin/ \
    && ln -sf /opt/ffmpeg/bin/ffmpeg /usr/local/bin/ffmpeg \
    && ln -sf /opt/ffmpeg/bin/ffprobe /usr/local/bin/ffprobe \
    && rm -rf /tmp/ff* \
    && ffmpeg -hide_banner -version | head -1

RUN python3 -m venv /opt/comfyui-venv \
    && /opt/comfyui-venv/bin/pip install -U --no-cache-dir pip wheel setuptools \
    && /opt/comfyui-venv/bin/pip install --no-cache-dir \
        torch torchvision torchaudio --index-url "https://download.pytorch.org/whl/${TORCH_INDEX}" \
    && /opt/comfyui-venv/bin/python -c "import torch;print('torch',torch.__version__,'cuda',torch.version.cuda)"

RUN git clone https://github.com/comfyanonymous/ComfyUI.git /opt/ComfyUI \
    && cd /opt/ComfyUI \
    && git checkout "${COMFYUI_REF}" \
    && /opt/comfyui-venv/bin/pip install --no-cache-dir -r requirements.txt \
    && /opt/comfyui-venv/bin/python -c "import comfy_kitchen; print('comfy-kitchen ok')" \
    && rm -rf /opt/ComfyUI/.git

COPY build/nodes.sh /opt/nodes.sh
RUN bash /opt/nodes.sh \
    && cd /opt/ComfyUI \
    && for req in custom_nodes/*/requirements.txt; do \
         [ -f "$req" ] && /opt/comfyui-venv/bin/pip install --no-cache-dir -r "$req" || true; \
       done \
    && /opt/comfyui-venv/bin/pip install --no-cache-dir \
         piexif rotary-embedding-torch numexpr imageio-ffmpeg pykalman \
         spandrel spandrel_extra_arches pandas segment-anything webcolors \
         sqlalchemy opencv-python-headless scikit-image \
    && rm -rf /root/.cache/pip /opt/ComfyUI/models/*/.git 2>/dev/null || true

COPY workflows/ /opt/ComfyUI/user/default/workflows/
COPY build/start.sh /opt/start.sh
COPY build/sshsetup.sh /opt/sshsetup.sh
COPY build/verify-env.sh /opt/verify-env.sh

RUN chmod +x /opt/start.sh /opt/sshsetup.sh /opt/verify-env.sh \
    && SSH_AUTHORIZED_KEY="${SSH_AUTHORIZED_KEY}" bash /opt/sshsetup.sh \
    && bash /opt/verify-env.sh

EXPOSE 22 8188
WORKDIR /opt/ComfyUI
ENTRYPOINT ["/usr/bin/tini","--"]
CMD ["/opt/start.sh"]
