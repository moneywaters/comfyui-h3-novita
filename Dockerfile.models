# =============================================================================
# PART 2/2 — model weight layers.
#
#   podman build --build-arg PART=h3diff -f Dockerfile.models .
#
# Built FROM the same nvidia/cuda base as Dockerfile.env so the extra layers are
# pure "model file" overlays. ops/compose-image.py then appends only the *new*
# layers of each PART onto the env image, producing one image with every model
# baked in while no single build needs more than ~25 GB of runner disk.
#
# NOTE: curl is installed here from apt. That rewrite of /var/lib/dpkg/status is
# inherited by the composed image, which is cosmetically inaccurate for packages
# but has no effect at runtime (nothing in the container runs apt).
# =============================================================================
FROM nvidia/cuda:13.0.1-cudnn-runtime-ubuntu24.04

ARG DEBIAN_FRONTEND=noninteractive
ARG PART=h3-fl2va
ARG HF_TOKEN=""
ARG WITH_PE=0

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && curl --version | head -1

COPY build/models-part.sh /opt/models-part.sh
# Splits any weight larger than the threshold into sub-4 GB chunks so no single layer is
# big enough to break SimplePod's image unpack. Invoked by the RUN below, not by
# models-part.sh -- the ordering there is deliberate, see that RUN's comment.
COPY build/chunk-model.sh /opt/chunk-model.sh
RUN chmod +x /opt/models-part.sh /opt/chunk-model.sh

# DOWNLOAD and CHUNK must be separate RUN instructions.
#
# They were one RUN, and the resulting layer was still 20.95 GB: podman diffs a layer by
# what the instruction created, not by its final state, so a 20 GB file that is created
# and then deleted inside the same RUN is still captured whole. Two RUNs put the fat file
# in its own layer, which compose-image.py then drops because it appends only the trailing
# layers a part adds -- leaving just the ~3.5 GB chunks.
RUN --mount=type=secret,id=hf_token,required=false \
    export HF_TOKEN="${HF_TOKEN:-$(cat /run/secrets/hf_token 2>/dev/null || true)}" \
    && PART="${PART}" WITH_PE="${WITH_PE}" bash /opt/models-part.sh

# Now split whatever is oversized. Separate RUN => separate layer => the chunks are what
# survive into the composed image.
RUN if [ "${CHUNK_ENABLED:-1}" = "1" ] && [ -x /opt/chunk-model.sh ]; then \
        shopt -s nullglob; \
        for f in /opt/ComfyUI/models/diffusion_models/*.safetensors \
                 /opt/ComfyUI/models/text_encoders/*.safetensors \
                 /opt/ComfyUI/models/vae/*.safetensors \
                 /opt/ComfyUI/models/SEEDVR2/*.safetensors; do \
            [ -f "$f" ] || continue; \
            bash /opt/chunk-model.sh "$f" 3500 | sed 's/^/  /'; \
        done; \
        shopt -u nullglob; \
    fi; \
    du -sh /opt/ComfyUI/models/* 2>/dev/null | sort -rh | head; \
    echo "=== chunk verification ==="; \
    chunks=$(find /opt/ComfyUI/models -name '*.part[0-9][0-9][0-9]' 2>/dev/null | wc -l); \
    left=$(find /opt/ComfyUI/models -name '*.safetensors' -size +4G 2>/dev/null | wc -l); \
    echo "chunk files: $chunks   unchunked files over 4 GB: $left"; \
    if [ "$left" -gt 0 ]; then \
        echo "ERROR: these are still too large for SimplePod to unpack:"; \
        find /opt/ComfyUI/models -name '*.safetensors' -size +4G -exec basename {} \;; \
        exit 1; \
    fi; \
    echo "OK: layer shape is SimplePod-safe"
